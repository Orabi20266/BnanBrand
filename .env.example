# ===== إعدادات الخادم =====
PORT=4000
NODE_ENV=development

# مفتاح تسجيل الدخول (JWT) — غيّره إلى قيمة عشوائية طويلة في الإنتاج
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# بيانات دخول الأدمن (تُضبط في متغيرات البيئة قبل أول تشغيل / seed)
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=choose-a-strong-password

# رابط الواجهة الأمامية (CORS + روابط البريد)
CLIENT_URL=http://localhost:5173

# مسارات البيانات (اختياري — تُستخدم عند النشر مع قرص دائم مثل Render)
# DB_PATH=/var/data/bnanbrand.db
# UPLOADS_PATH=/var/data/uploads

# ===== البريد الإلكتروني (Nodemailer) =====
# اتركه فارغاً في وضع التطوير: سيتم تسجيل الرسائل في الطرفية وقاعدة البيانات.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BnanBrand <no-reply@bnanbrand.com>"
